# =============================================================================
# Server
# =============================================================================
PORT=3000
NODE_ENV=development
# Comma-separated frontend origins allowed by CORS and the WebSocket gateway.
CLIENT_URL=http://localhost:3001

# =============================================================================
# JWT / OIDC (RS256)
# =============================================================================
# Optional: if unset, an ephemeral RSA keypair is generated at boot (dev only).
# Generate real keys with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# and paste them here as PEM strings (use \n for newlines when embedded in .env).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

JWT_ISSUER=http://localhost:3000
JWT_DEFAULT_AUDIENCE=internship-platform
JWT_ACCESS_TTL_SECONDS=900          # 15 min
JWT_REFRESH_TTL_SECONDS=1209600     # 14 days

# =============================================================================
# OAuth 2.0 client-credentials (service-to-service)
# Format: client_id:client_secret:scope1 scope2, comma-separated for multiple
# Example: ml-service:changeme:matching:read matching:write,notifier:changeme:notify:send
# =============================================================================
OAUTH_CLIENTS=

# =============================================================================
# Social login providers
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

META_CLIENT_ID=
META_CLIENT_SECRET=
META_CALLBACK_URL=http://localhost:3000/auth/meta/callback

# Frontend URL to redirect to after successful OAuth login.
# Tokens are appended as query params (access_token, refresh_token, expires_in).
FRONTEND_OAUTH_REDIRECT=http://localhost:4200/auth/callback

# =============================================================================
# Database
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=internship
# Auto-sync tables from entities. Defaults to true outside production, false in
# production. Set explicitly to override (e.g. docker-compose sets true).
# DB_SYNCHRONIZE=true

# =============================================================================
# Redis (BullMQ + refresh-token store)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1
CACHE_TTL_SECONDS=300

# =============================================================================
# ML Service
# =============================================================================
ML_SERVICE_URL=http://localhost:8000
# Must equal API_KEY in ml-service/.env. Use a long random value outside local dev.
ML_SERVICE_API_KEY=your-secret-api-key-here
# Per-attempt HTTP timeout for ML calls (ms). Retries + circuit breaker wrap this.
ML_SERVICE_TIMEOUT_MS=10000

# =============================================================================
# Seed script (npm run seed) — dev/demo data and the first admin account.
# Admins cannot self-register; this is the supported way to create one.
# =============================================================================
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# =============================================================================
# OpenTelemetry (Distributed Tracing)
# =============================================================================
# Set OTEL_SDK_DISABLED=true to turn tracing off (e.g. when no collector runs).
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=nest-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
